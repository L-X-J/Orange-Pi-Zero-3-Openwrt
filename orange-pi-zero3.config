#
# Orange Pi Zero 3 (H618, 1GB) -- ImmortalWrt openwrt-24.10 (Linux 6.6 LTS)
# Role: dedicated low-memory proxy / "science" router.
#
# Principles:
#   * proxy stack + board support + management/debug tools only
#   * no Docker / Samba / aria2 / adbyby / unblockneteasemusic / printer / NAS
#   * zram-swap absorbs OpenClash rule updates and large transfers on 1GB RAM
#
# `make defconfig` resolves the remaining dependencies; this file only pins the
# packages we deliberately own.
#

# ---------------------------------------------------------------------------
# Target hardware (must stay unchanged)
# ---------------------------------------------------------------------------
CONFIG_TARGET_sunxi=y
CONFIG_TARGET_sunxi_cortexa53=y
CONFIG_TARGET_sunxi_cortexa53_DEVICE_xunlong_orangepi-zero3=y
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
CONFIG_SUNXI_SD_BOOT_PARTSIZE=256

# ---------------------------------------------------------------------------
# Onboard AW859A / UWE5622 Wi-Fi
# openwrt-24.10 does not ship this driver; diy-part1.sh backports the 6.6
# mac80211 driver + firmware + the Zero 2/Zero 3 DTS nodes.
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-uwe5622=y
CONFIG_PACKAGE_uwe5622-firmware=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_iw-full=y

# ---------------------------------------------------------------------------
# Proxy front-end: OpenClash only
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-openclash=y

# OpenClash config import/export requires Ruby + YAML support
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-bigdecimal=y
CONFIG_PACKAGE_ruby-date=y
CONFIG_PACKAGE_ruby-digest=y
CONFIG_PACKAGE_ruby-enc=y
CONFIG_PACKAGE_ruby-forwardable=y
CONFIG_PACKAGE_ruby-pstore=y
CONFIG_PACKAGE_ruby-psych=y
CONFIG_PACKAGE_ruby-stringio=y
CONFIG_PACKAGE_ruby-strscan=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_unzip=y

# OpenClash runtime helper
CONFIG_PACKAGE_ip-full=y

# PassWall / PassWall2 / SSR+ and their cores are intentionally absent.
# OpenClash ships/downloads its own Clash Meta core, so xray-core, sing-box,
# chinadns-ng, dns2socks and the other proxy backends are not needed.

# ---------------------------------------------------------------------------
# Firewall / transparent proxy data path (firewall4 = nftables)
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-br-netfilter=y

# dnsmasq-full is required by OpenClash (nftset for nftables)
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq_full_nftset=y

# ---------------------------------------------------------------------------
# Management / UI tools (kept minimal)
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-compat=y
# iStore/quickstart dependency guard (checked by the workflow)
CONFIG_PACKAGE_xz-utils=y

# ---------------------------------------------------------------------------
# Memory safety on 1GB boards: compressed swap for OpenClash rule updates
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y

# ---------------------------------------------------------------------------
# IPv6 WAN basics (transparent proxy over IPv6)
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-proto-ipv6=y

# ---------------------------------------------------------------------------
# Explicitly disabled: must not creep back into the image
# ---------------------------------------------------------------------------
# CONFIG_PACKAGE_docker is not set
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_containerd is not set
# CONFIG_PACKAGE_runc is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_samba4-server is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_aria2 is not set
# CONFIG_PACKAGE_luci-app-aria2 is not set
# CONFIG_PACKAGE_ariang is not set
# CONFIG_PACKAGE_luci-app-unblockneteasemusic is not set
