#!/bin/sh
#
# Print the router-mode management address and Wi-Fi credentials on the
# serial console after network is up. Values are read from UCI so the banner
# follows later changes.

lan_ip="$(uci -q get network.lan.ipaddr)"
[ -n "$lan_ip" ] || lan_ip="192.168.44.1"

ssid="$(uci -q get 'wireless.@wifi-iface[0].ssid')"
key="$(uci -q get 'wireless.@wifi-iface[0].key')"
[ -n "$ssid" ] || ssid="OPi-Mini"
[ -n "$key" ] || key="(open)"

if [ -w /dev/console ]; then
	{
		echo
		echo "=================================================="
		echo " Orange Pi Zero 3 - router mode"
		echo " Wi-Fi: $ssid / $key"
		echo " LuCI : http://$lan_ip"
		echo " SSH  : ssh root@$lan_ip"
		echo "=================================================="
		echo
	} > /dev/console
fi

exit 0
