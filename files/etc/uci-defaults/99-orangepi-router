#!/bin/sh
#
# Orange Pi Zero 3 -- main router mode, single Ethernet port as WAN.
#
#   modem / upstream LAN
#     +-- eth0 (WAN, DHCP client)
#     +-- Wi-Fi AP (LAN, 192.168.44.1/24, DHCP server on)
#
# The onboard UWE5622 radio is deliberately put on 2.4GHz: it is more
# compatible with phones/PCs than the 5GHz VHT80 AP on this third-party
# driver. Change band/channel/htmode later if you want 5GHz.
#
# This runs once on first boot (uci-defaults), before netifd starts.

LAN_IP="192.168.44.1"
LAN_MASK="255.255.255.0"
WAN_DEV="eth0"
WIFI_SSID="OPi-Mini"
WIFI_KEY="aa88888888"

[ -f /etc/config/network ] || exit 0

# Drop a leftover bypass script from older images.
rm -f /etc/uci-defaults/99-orangepi-bypass

# 1) br-lan is Wi-Fi only: eth0 moves to WAN, so keep an empty bridge.
br_found=0
i=0
while uci -q get "network.@device[$i]" >/dev/null 2>&1; do
	if [ "$(uci -q get "network.@device[$i].name")" = "br-lan" ]; then
		br_found=1
		uci -q delete "network.@device[$i].ports"
		uci set "network.@device[$i].bridge_empty=1"
	fi
	i=$((i + 1))
done

if [ "$br_found" = 0 ]; then
	uci add network device
	uci set network.@device[-1].name='br-lan'
	uci set network.@device[-1].type='bridge'
	uci set network.@device[-1].bridge_empty='1'
fi

# 2) LAN: static management/DHCP network on the Wi-Fi bridge.
uci set network.lan='interface'
uci set network.lan.device='br-lan'
uci set network.lan.proto='static'
uci set network.lan.ipaddr="$LAN_IP"
uci set network.lan.netmask="$LAN_MASK"
uci set network.lan.ip6assign='60'
uci -q delete network.lan.gateway
uci -q delete network.lan.dns
uci -q delete network.lan.ifname
uci -q delete network.lan.type
uci -q delete network.lan.ports

# 3) WAN: the single Ethernet port.
uci -q delete network.wan
uci set network.wan='interface'
uci set network.wan.device="$WAN_DEV"
uci set network.wan.proto='dhcp'

uci -q delete network.wan6
uci set network.wan6='interface'
uci set network.wan6.device="$WAN_DEV"
uci set network.wan6.proto='dhcpv6'

# 4) LAN DHCP/RA server.
uci set dhcp.lan.ignore='0'
uci set dhcp.lan.dhcpv4='server'
uci set dhcp.lan.dhcpv6='server'
uci set dhcp.lan.ra='server'
uci set dhcp.lan.start='100'
uci set dhcp.lan.limit='150'
uci set dhcp.lan.leasetime='12h'

# 5) Firewall: LAN is trusted, WAN stays masqueraded, no flow offload.
i=0
while uci -q get "firewall.@zone[$i]" >/dev/null 2>&1; do
	if [ "$(uci -q get "firewall.@zone[$i].name")" = "lan" ]; then
		uci set "firewall.@zone[$i].input=ACCEPT"
		uci set "firewall.@zone[$i].output=ACCEPT"
		uci set "firewall.@zone[$i].forward=ACCEPT"
	fi
	i=$((i + 1))
done

if uci -q get firewall.@defaults[0] >/dev/null 2>&1; then
	uci set firewall.@defaults[0].flow_offloading='0'
	uci set firewall.@defaults[0].flow_offloading_hw='0'
fi

# 6) Wi-Fi AP: 2.4GHz, WPA2-PSK, fixed SSID/password.
#    Iterate the generated sections so this works even if the radio is not
#    literally named radio0.
i=0
while uci -q get "wireless.@wifi-device[$i]" >/dev/null 2>&1; do
	uci set "wireless.@wifi-device[$i].band=2g"
	uci set "wireless.@wifi-device[$i].channel=6"
	uci set "wireless.@wifi-device[$i].htmode=HT40"
	uci set "wireless.@wifi-device[$i].disabled=0"
	i=$((i + 1))
done

i=0
while uci -q get "wireless.@wifi-iface[$i]" >/dev/null 2>&1; do
	uci set "wireless.@wifi-iface[$i].network=lan"
	uci set "wireless.@wifi-iface[$i].mode=ap"
	uci set "wireless.@wifi-iface[$i].ssid=$WIFI_SSID"
	uci set "wireless.@wifi-iface[$i].encryption=psk2"
	uci set "wireless.@wifi-iface[$i].key=$WIFI_KEY"
	uci set "wireless.@wifi-iface[$i].disabled=0"
	i=$((i + 1))
done
uci commit wireless

uci commit network
uci commit dhcp
uci commit firewall

# 7) First-boot hint on the serial console.
{
	echo
	echo "=================================================="
	echo " Orange Pi Zero 3 - router mode"
	echo " Wi-Fi: $WIFI_SSID / $WIFI_KEY"
	echo " LuCI : http://$LAN_IP"
	echo " SSH  : ssh root@$LAN_IP"
	echo "=================================================="
	echo
} > /dev/console 2>/dev/null

exit 0
