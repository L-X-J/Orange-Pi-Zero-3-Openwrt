#!/bin/sh
#
# Orange Pi Zero 3 has a single Ethernet port. The stock openwrt-24.10 sunxi
# board script (target/linux/sunxi/base-files/etc/board.d/02_network) puts
# eth0 into br-lan, i.e. dumb-AP mode. With a modem plugged into eth0, the
# modem's LAN and this router's LAN end up on the same L2 segment: clients
# receive the modem's DHCP lease (192.168.1.x) and the router is not routing.
#
# Router mode for this board:
#   eth0  -> WAN (DHCP client towards the ISP modem)
#   Wi-Fi -> LAN (br-lan, 192.168.44.1/24, dnsmasq/DHCP)
#
# This runs once on first boot (uci-defaults), before netifd starts.

[ -f /etc/config/network ] || exit 0

# 1) Remove eth0 from br-lan and allow the bridge to stay up with no wired
#    ports. hostapd attaches the Wi-Fi AP to br-lan through network=lan.
i=0
while uci -q get "network.@device[$i]" >/dev/null 2>&1; do
	if [ "$(uci -q get "network.@device[$i].name")" = "br-lan" ]; then
		uci -q delete "network.@device[$i].ports"
		uci set "network.@device[$i].bridge_empty=1"
	fi
	i=$((i + 1))
done

# 2) LAN: static management address, served over Wi-Fi only.
uci set network.lan='interface'
uci set network.lan.device='br-lan'
uci set network.lan.proto='static'
uci set network.lan.ipaddr='192.168.44.1'
uci set network.lan.netmask='255.255.255.0'
uci set network.lan.ip6assign='60'

# 3) WAN: the physical Ethernet port goes to the ISP modem.
uci -q delete network.wan
uci set network.wan='interface'
uci set network.wan.device='eth0'
uci set network.wan.proto='dhcp'

uci -q delete network.wan6
uci set network.wan6='interface'
uci set network.wan6.device='eth0'
uci set network.wan6.proto='dhcpv6'

# 4) Keep the onboard AP on the LAN bridge and enabled.
if uci -q get wireless.@wifi-iface[0] >/dev/null 2>&1; then
	uci set wireless.@wifi-iface[0].network='lan'
	uci set wireless.@wifi-iface[0].disabled='0'
	uci commit wireless
fi

uci commit network
exit 0
