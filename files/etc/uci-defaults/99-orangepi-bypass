#!/bin/sh
#
# Orange Pi Zero 3 -- bypass router mode (single Ethernet port = LAN).
#
# The main router / optical modem keeps doing DHCP and stays the gateway
# (default 192.168.1.1). This board joins the same L2 segment with a static
# management address and has its own DHCP server disabled, so there is no
# second DHCP server on 192.168.1.0/24.
#
#   main router 192.168.1.1
#     +-- PC / phone          (DHCP from the main router)
#     +-- Orange Pi Zero 3    (static 192.168.1.250, DHCP off)
#
# Clients that should use OpenClash set gateway + DNS to 192.168.1.250,
# or the main router hands those values out via DHCP options.
#
# This runs once on first boot (uci-defaults), before netifd starts.

LAN_IP="192.168.1.250"
MAIN_GW="192.168.1.1"
LAN_MASK="255.255.255.0"

[ -f /etc/config/network ] || exit 0

# Drop a leftover main-router script from older images so it cannot move
# eth0 to WAN later in this same boot.
rm -f /etc/uci-defaults/99-orangepi-router

# 1) br-lan must contain the single Ethernet port, and must not be an empty
#    bridge anymore.
br_found=0
i=0
while uci -q get "network.@device[$i]" >/dev/null 2>&1; do
	if [ "$(uci -q get "network.@device[$i].name")" = "br-lan" ]; then
		br_found=1
		uci -q delete "network.@device[$i].bridge_empty"
		ports="$(uci -q get "network.@device[$i].ports")"
		case " $ports " in
			*" eth0 "*) ;;
			*) uci add_list "network.@device[$i].ports=eth0" ;;
		esac
	fi
	i=$((i + 1))
done

if [ "$br_found" = 0 ]; then
	uci add network device
	uci set network.@device[-1].name='br-lan'
	uci set network.@device[-1].type='bridge'
	uci add_list network.@device[-1].ports='eth0'
fi

# 2) LAN: static management address on the main network, main router as
#    gateway/DNS. No WAN interface: this box only has one Ethernet port.
uci set network.lan='interface'
uci set network.lan.device='br-lan'
uci set network.lan.proto='static'
uci set network.lan.ipaddr="$LAN_IP"
uci set network.lan.netmask="$LAN_MASK"
uci set network.lan.gateway="$MAIN_GW"
uci set network.lan.dns="$MAIN_GW"
uci -q delete network.lan.ifname
uci -q delete network.lan.type
uci -q delete network.lan.ports
uci -q delete network.lan.ip6assign

uci -q delete network.wan
uci -q delete network.wan6

# 3) Do not run a second DHCP/RA server on the main LAN.
uci set dhcp.lan.ignore='1'
uci -q delete dhcp.lan.dhcpv4
uci -q delete dhcp.lan.dhcpv6
uci -q delete dhcp.lan.ra
uci -q delete dhcp.lan.ra_slaac
uci -q delete dhcp.lan.ra_flags

# 4) Management traffic (LuCI 80 / SSH 22) must be accepted on LAN.
i=0
while uci -q get "firewall.@zone[$i]" >/dev/null 2>&1; do
	if [ "$(uci -q get "firewall.@zone[$i].name")" = "lan" ]; then
		uci set "firewall.@zone[$i].input=ACCEPT"
		uci set "firewall.@zone[$i].output=ACCEPT"
		uci set "firewall.@zone[$i].forward=ACCEPT"
	fi
	i=$((i + 1))
done

# Flow offloading bypasses the nftables redirect rules used by OpenClash.
if uci -q get firewall.@defaults[0] >/dev/null 2>&1; then
	uci set firewall.@defaults[0].flow_offloading='0'
	uci set firewall.@defaults[0].flow_offloading_hw='0'
fi

# 5) Keep the onboard Wi-Fi AP on the same LAN.
if uci -q get wireless.@wifi-iface[0] >/dev/null 2>&1; then
	uci set wireless.@wifi-iface[0].network='lan'
	uci set wireless.@wifi-iface[0].disabled='0'
	uci commit wireless
fi

uci commit network
uci commit dhcp
uci commit firewall

# 6) First-boot hint on the serial console.
{
	echo
	echo "=================================================="
	echo " Orange Pi Zero 3 - bypass router"
	echo " LuCI : http://$LAN_IP"
	echo " SSH  : ssh root@$LAN_IP"
	echo " Client gateway/DNS: $LAN_IP"
	echo "=================================================="
	echo
} > /dev/console

exit 0
